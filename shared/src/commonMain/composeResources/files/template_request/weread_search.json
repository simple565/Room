{
  "name": "微信读书搜索",
  "description": "用于搜索微信读书中的书籍",
  "type": "book",
  "request": {
    "url": "https://weread.qq.com/web/search/global",
    "method": "GET",
    "headers": [],
    "params": [
      {
        "key": "keyword",
        "value": "",
        "isDynamic": true
      },
      {
        "key": "count",
        "value": "",
        "isDynamic": true
      }
    ],
    "body": {
      "type": "json",
      "content": "{}"
    }
  },
  "response": {
    "mapping": {
      "title": "$.books[*].title",
      "description": "$.books[*].intro",
      "image": "$.books[*].cover",
      "id": "$.books[*].bookId"
    }
  }
}