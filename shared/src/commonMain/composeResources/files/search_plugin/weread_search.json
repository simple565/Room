
{
  "name": "微信读书",
  "description": "用于搜索微信读书中书籍",
  "url": "https://weread.qq.com/web/search/global",
  "method": "GET",
  "headers": {},
  "params": [
    {
      "key": "keyword",
      "value": "{keyword}"
    },
    {
      "key": "count",
      "value": "{count}"
    }
  ],
  "body": [],
  "itemRegex": "\\\"bookInfo\\\":\\{([^}]*(?:\\{[^}]*\\}[^}]*)*)\\}",
  "mapping": [
    {
      "type": "Image",
      "name": "封面",
      "regex": "\"cover\"\\s*:\\s*\"([^\"]*)\"",
      "value": ""
    },
    {
      "type": "",
      "name": "id",
      "regex": "\"bookId\"\\s*:\\s*\"([^\"]*)\"",
      "value": ""
    },
    {
      "type": "Text",
      "name": "名称",
      "regex": "\"title\"\\s*:\\s*\"([^\"]*)\"",
      "value": ""
    },
    {
      "type": "MultiSelect",
      "name": "作者",
      "regex": "\"author\"\\s*:\\s*\"([^\"]*)\"",
      "value": ""
    },
    {
      "type": "Text",
      "name": "简介",
      "regex": "\"intro\"\\s*:\\s*\"([^\"]*)\"",
      "value": ""
    }
  ]
}