
{
  "name": "微信读书",
  "description": "用于搜索微信读书中书籍",
  "url": "https://weread.qq.com/web/search/global",
  "method": "GET",
  "headers": {},
  "params": [
    {
      "key": "keyword",
      "value": "",
      "isDynamic": true
    },
    {
      "key": "count",
      "value": "20",
      "isDynamic": false
    }
  ],
  "body": [],
  "itemRegex": "\\\"bookInfo\\\":\\{([^}]*(?:\\{[^}]*\\}[^}]*)*)\\}",
  "mapping": [
    {
      "name": "封面",
      "regex": "\"cover\"\\s*:\\s*\"([^\"]*)\"",
      "value": ""
    },
    {
      "name": "id",
      "regex": "\"bookId\"\\s*:\\s*\"([^\"]*)\"",
      "value": ""
    },
    {
      "name": "名称",
      "regex": "\"title\"\\s*:\\s*\"([^\"]*)\"",
      "value": ""
    },
    {
      "name": "作者",
      "regex": "\"author\"\\s*:\\s*\"([^\"]*)\"",
      "value": ""
    },
    {
      "name": "简介",
      "regex": "\"intro\"\\s*:\\s*\"([^\"]*)\"",
      "value": ""
    }
  ]
}