{
  "name": "豆瓣图书",
  "description": "用于搜索豆瓣图书中书籍",
  "url": "https://api.douban.com/v2/book/search",
  "method": "POST",
  "headers": {
    "Referer": "https://book.douban.com"
  },
  "params": [],
  "body": [
    {
      "key": "apikey",
      "value": "0ab215a8b1977939201640fa14c66bab"
    },
    {
      "key": "q",
      "value": "{keyword}"
    },
    {
      "key": "start",
      "value": "{offset}"
    },
    {
      "key": "count",
      "value": "{count}"
    }
  ],
  "itemRegex": "\\{\\s*\"rating\"\\s*:\\s*\\{.*?\"price\"\\s*:\\s*\"[^\"]*\"\\s*\\}",
  "mapping": [
    {
      "type": "Image",
      "name": "封面",
      "regex": "\"image\"\\s*:\\s*\"([^\"]*)\"",
      "value": ""
    },
    {
      "type": "",
      "name": "id",
      "regex": "\"id\"\\s*:\\s*\"([^\"]*)\"",
      "value": ""
    },
    {
      "type": "Text",
      "name": "名称",
      "regex": "\"title\"\\s*:\\s*\"([^\"]*)\"(?:[^}])*?\"url\"",
      "value": ""
    },
    {
      "type": "MultiSelect",
      "name": "作者",
      "regex": "\"author\"\\s*:\\s*(\\[[^\\]]*\\])",
      "value": ""
    },
    {
      "type": "Text",
      "name": "简介",
      "regex": "\"summary\"\\s*:\\s*\"([^\"]*)\"",
      "value": ""
    }
  ]
}